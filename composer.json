{
    "name": "gurucomkz/rel-picker",
    "description": "Relation Picker field for SilverStripe",
    "license": "BSD-3-Clause",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "tag",
        "field"
    ],
    "authors": [
        {
            "name": "Sergey Shevchenko",
            "homepage": "http://github.com/gurucomkz"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/admin": "^2@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "9.5.28",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Gurucomkz\\RelPickerField\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.x-dev"
        },
        "expose": [
            "client/dist"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
